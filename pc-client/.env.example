# === Rust+ подключение (см. README как получить) ===
RUST_SERVER_IP=192.168.1.1
RUST_SERVER_PORT=28083
RUST_PLAYER_ID=76561198000000000
RUST_PLAYER_TOKEN=123456789

# === Firebase ===
# Путь к JSON-файлу сервисного аккаунта Firebase (Project Settings -> Service Accounts -> Generate key)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# URL Realtime Database, вида https://<project-id>-default-rtdb.<region>.firebasedatabase.app
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Как часто опрашивать статус команды (мс)
POLL_INTERVAL_MS=5000

# Как часто проверять игровые события: вертолёт/карго/чинук/крейт (мс)
EVENTS_POLL_INTERVAL_MS=15000

# === Steam Web API (для аватарок тиммейтов) ===
# Бесплатный ключ: https://steamcommunity.com/dev/apikey
# Без ключа аватарки просто не подтянутся — приложение покажет
# цветной кружок с инициалами вместо фото.
STEAM_API_KEY=

# === RustMaps.com (для красивой карты вместо сырой из Rust+, опционально) ===
# Бесплатный ключ: https://rustmaps.com/dashboard
# Без ключа используется штатная карта из Rust+ (тоже рабочая, но проще визуально).
RUSTMAPS_API_KEY=

# === Чат-бот (!help / !time / !online в чате команды) ===
# Отвечает от имени аккаунта pc-client. Чтобы выключить — поставь off
CHAT_BOT=on
# Кому доступны !команды: everyone — всем, admins — владельцу и списку
# CHAT_BOT_ADMINS, owner — только владельцу аккаунта pc-client
CHAT_BOT_ACCESS=everyone
# SteamID64 админов через запятую (для CHAT_BOT_ACCESS=admins)
CHAT_BOT_ADMINS=

# === Discord-мост (опционально) ===
# Вебхук канала: дублирует спавны хели/карго/чинука/крейта, срабатывания
# сигнализаций и смерти тиммейтов. Создаётся в настройках канала Discord
# («Интеграции» → «Вебхуки»). Оставь пустым, чтобы выключить.
DISCORD_WEBHOOK_URL=
